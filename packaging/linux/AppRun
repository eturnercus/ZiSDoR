#!/bin/sh
# Точка входа AppImage. Интерфейс лаунчера работает на системном WebKitGTK,
# поэтому перед запуском проверяем, что библиотека установлена, и подсказываем, как её поставить.
HERE="$(dirname "$(readlink -f "$0")")"

missing=""
LDCONFIG="$(command -v ldconfig 2>/dev/null || true)"
[ -z "$LDCONFIG" ] && [ -x /sbin/ldconfig ] && LDCONFIG=/sbin/ldconfig
if [ -n "$LDCONFIG" ]; then
	libs="$("$LDCONFIG" -p 2>/dev/null)"
	if [ -n "$libs" ]; then
		echo "$libs" | grep -q 'libwebkit2gtk-4\.1\.so\.0' || missing="$missing webkit2gtk-4.1"
		echo "$libs" | grep -q 'libcurl\.so\.4' || missing="$missing libcurl"
	fi
fi

if [ -n "$missing" ]; then
	msg="Для работы GDZLauncher нужны системные библиотеки:$missing

Ubuntu / Debian / Mint:  sudo apt install libwebkit2gtk-4.1-0 libcurl4
Fedora:                  sudo dnf install webkit2gtk4.1 libcurl
Arch:                    sudo pacman -S webkit2gtk-4.1 curl"
	echo "$msg" >&2
	if command -v zenity >/dev/null 2>&1; then
		zenity --error --title="GDZLauncher" --text="$msg" 2>/dev/null
	elif command -v kdialog >/dev/null 2>&1; then
		kdialog --title "GDZLauncher" --error "$msg" 2>/dev/null
	elif command -v notify-send >/dev/null 2>&1; then
		notify-send "GDZLauncher" "$msg"
	fi
	exit 1
fi

exec "$HERE/usr/bin/launcher" "$@"
