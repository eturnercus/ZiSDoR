// Файл сгенерирован CMake из cmake/build_config.hpp.in. Не редактировать.
// Параметры сборки лежат в заголовке, а не в -D с кавычками: так их одинаково понимают
// MSVC, MinGW, GCC и компиляторы ресурсов (rc.exe, windres).
#pragma once

